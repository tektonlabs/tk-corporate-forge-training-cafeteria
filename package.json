{
  "name": "cafeteria",
  "private": true,
  "version": "0.4.0",
  "description": "Pedidos de la cafetería interna",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @cafeteria/api\" \"npm run dev -w @cafeteria/web\"",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
